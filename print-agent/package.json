{
  "name": "copakapana-print-agent",
  "version": "1.0.0",
  "description": "Copakapana POS — bill print agent (runs on the restaurant PC)",
  "main": "dist/agent.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/agent.ts",
    "build": "tsc",
    "start": "node dist/agent.js",
    "test-print": "tsc && node dist/test-print.js",
    "list-printers": "tsc && node dist/test-print.js --list"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}