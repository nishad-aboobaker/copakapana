{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>/src/__tests__"],
  "testMatch": ["**/*.test.ts"],
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
  },
  "moduleFileExtensions": ["ts", "js", "json"],
  "collectCoverageFrom": ["src/**/*.ts", "!src/seeds/**", "!src/server.ts"],
  "coverageDirectory": "coverage",
  "verbose": true
}
