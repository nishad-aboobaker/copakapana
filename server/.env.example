# Server
PORT=5000
# Set to production on AWS
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/kotdb?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Print Agent (a long random string shared with print-agent/.env)
AGENT_TOKEN=change_this_to_a_long_random_agent_token

# Seed defaults (used by seed script only)
SEED_OWNER_NAME=owner
SEED_OWNER_PASSWORD=changeme123

# CORS — comma-separated allowed origins (add your Vercel URL / custom domain in production)
CORS_ORIGINS=http://localhost:4200

# Behind Nginx or a load balancer in production: true
TRUST_PROXY=
